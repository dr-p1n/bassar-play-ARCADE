{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bassar",
  "main": "src/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "bassarplay.com", "custom_domain": true },
    { "pattern": "www.bassarplay.com", "custom_domain": true }
  ]
}
